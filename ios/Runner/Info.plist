<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Pepper Clinical Infinity V6 — iOS Info.plist
  © 2026 Lamya Fadlulmola Hamed Ali
-->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key><string>$(DEVELOPMENT_LANGUAGE)</string>
  <key>CFBundleDisplayName</key><string>Pepper Clinical V6</string>
  <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <key>CFBundleName</key><string>pepper_clinical</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>6.0.0</string>
  <key>CFBundleSignature</key><string>????</string>
  <key>CFBundleVersion</key><string>1</string>

  <!-- Camera permission - REQUIRED -->
  <key>NSCameraUsageDescription</key>
  <string>Pepper Clinical uses the camera to track your child's attention, facial expressions, and movements during therapy sessions. All processing is done locally on your device — no video is sent anywhere.</string>

  <!-- Microphone for speech recognition -->
  <key>NSMicrophoneUsageDescription</key>
  <string>Pepper Clinical uses the microphone to allow your child to practice verbal tasks through speech recognition.</string>

  <!-- Photo library (for saving reports) -->
  <key>NSPhotoLibraryAddUsageDescription</key>
  <string>Pepper Clinical saves therapy reports to your photo library.</string>
  <key>NSPhotoLibraryUsageDescription</key>
  <string>Pepper Clinical accesses the photo library to save session reports.</string>

  <!-- Face ID (secure storage) -->
  <key>NSFaceIDUsageDescription</key>
  <string>Pepper Clinical uses Face ID to securely authenticate your account.</string>

  <!-- Background modes -->
  <key>UIBackgroundModes</key>
  <array>
    <string>audio</string>
    <string>fetch</string>
  </array>

  <!-- Supported orientations -->
  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationPortraitUpsideDown</string>
  </array>
  <key>UISupportedInterfaceOrientations~ipad</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationPortraitUpsideDown</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>

  <key>UILaunchStoryboardName</key><string>LaunchScreen</string>
  <key>UIMainStoryboardFile</key><string></string>
  <key>UIViewControllerBasedStatusBarAppearance</key><false/>

  <!-- ML Kit — disable analytics -->
  <key>FirebaseAppDelegateProxyEnabled</key><false/>
  <key>FIRA_DISABLE_ANALYTICS</key><true/>
</dict>
</plist>
